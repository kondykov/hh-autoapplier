{
  "manifest_version": 3,
  "name": "HH AutoApplier",
  "version": "0.7.0",
  "description": "Полуавтоматические отклики на hh.ru",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.hh.ru/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hh.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
