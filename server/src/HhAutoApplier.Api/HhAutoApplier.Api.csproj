<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HhAutoApplier.Infrastructure\HhAutoApplier.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML-комментарии контроллеров попадают в OpenAPI -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- wwwroot — сборка веба из web/ (#130), в git её нет: npm run build:web в корне репозитория (в Docker — шаг Node) -->
  <Target Name="WarnNoWebBuild" BeforeTargets="Build" Condition="!Exists('wwwroot/index.html')">
    <Warning Text="Нет сборки веба (wwwroot/index.html): выполните npm run build:web в корне репозитория — без неё веб-интерфейс и его тесты не работают" />
  </Target>

</Project>
