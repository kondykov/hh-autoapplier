POSTGRES_PASSWORD=change-me
# Расширение входит по персональному токену hh_… (POST /api/tokens после входа по паролю) — общего ключа нет (#42)
# Первый администратор: создаётся при старте, пока администраторов нет. Пароль — не короче 10 символов.
# ВНИМАНИЕ: пароль в .env лежит открытым текстом. После первого старта сменить его (POST /api/auth/password в /scalar) и очистить ADMIN_PASSWORD;
# ADMIN_EMAIL оставить — ему переходят данные без владельца. На сервере .env не хранить в репозитории и бэкапах
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Сбор с публичных страниц hh.ru (без токена и аккаунта)
HH_ENABLED=true
COLLECT_INTERVAL_MINUTES=60
COLLECT_MAX_PAGES=20
# Страниц незавершённых откликов за проход проверяется на архив (вакансии не встречались в выдаче больше суток); 0 — не проверять
COLLECT_MAX_ARCHIVE_CHECKS=10
DB_PORT=5433
# LLM с OpenAI-совместимым API; по умолчанию Groq (ключ: https://console.groq.com/keys). Пустой ключ — LLM выключена
# ГигаЧат: LLM_PROVIDER=gigachat, LLM_API_KEY=<ключ авторизации из кабинета developers.sber.ru>,
# LLM_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1, LLM_MODEL=GigaChat
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Только для ГигаЧата: GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B и GIGACHAT_API_CORP — ИП и юрлица
LLM_SCOPE=GIGACHAT_API_PERS
# json_object или none (JSON задаётся промптом); пусто — как в профиле провайдера
LLM_JSON_MODE=
LLM_DAILY_LIMIT=300
# Доля одного пользователя в дневном лимите; 0 — без доли
LLM_USER_DAILY_LIMIT=150

# Модель под задачу (#104): оценка вакансий и разбор просьб к письму (EVALUATION), письма (LETTERS), анкеты (QUESTIONNAIRES),
# ответы работодателей (DIALOGS). Пусто — основной LLM_*. Задана только модель — тот же провайдер и ключ (например,
# LLM_EVALUATION_MODEL=openai/gpt-oss-20b: у Groq бесплатные лимиты считаются на каждую модель отдельно).
# Другой провайдер — PROVIDER, BASE_URL и обязательно свой API_KEY. У маршрута свой дневной лимит и своя пауза при 429.
# Пример: оценка — ГигаЧат, письма — основной провайдер:
# LLM_EVALUATION_PROVIDER=gigachat
# LLM_EVALUATION_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# LLM_EVALUATION_API_KEY=<ключ авторизации ГигаЧата>
# LLM_EVALUATION_MODEL=GigaChat-2-Max
LLM_EVALUATION_MODEL=
LLM_LETTERS_MODEL=
LLM_QUESTIONNAIRES_MODEL=
LLM_DIALOGS_MODEL=

# Подключения LLM, из которых пользователь выбирает модель по задаче (#107), — в llm-providers.env рядом с этим файлом
# (образец — llm-providers.env.example). Другой путь к файлу:
# LLM_PROVIDERS_FILE=llm-providers.env

# Исходящий прокси для Groq и Telegram (#5): с российского IP напрямую не работают. Пусто — напрямую.
# На home-server: HTTPS_PROXY=http://host.docker.internal:10810 (relay к Happ, docs/DEPLOY.md). hh.ru оставить в NO_PROXY
HTTPS_PROXY=
NO_PROXY=hh.ru,.hh.ru,db,localhost,127.0.0.1

# Адрес, на котором API слушает на хосте. По умолчанию 127.0.0.1 — только этот компьютер.
# 0.0.0.0 — вся домашняя сеть (http://<адрес сервера>:8080, #100). ufw порты Docker не фильтрует: на роутере 8080 не пробрасывать.
# Трафик — открытый HTTP: пароль и токен идут по сети без шифрования
API_BIND=

# Чужие источники для CORS через запятую (например chrome-extension://<id>); пусто — CORS выключен, расширению он не нужен
CORS_ORIGINS=
# Telegram-бот (токен от @BotFather); пусто — бот выключен. Привязка чата: POST /api/telegram/link после входа по паролю → /start <код>
TELEGRAM_BOT_TOKEN=
